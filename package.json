{
  "name": "miyp-timer",
  "productName": "MIYP Timer",
  "version": "0.3.0",
  "description": "MIYP Timer — таймер набросков для аниматора",
  "private": true,
  "main": "dist/electron/main.js",
  "scripts": {
    "build:renderer": "vite build",
    "build:electron": "node scripts/build-electron.mjs",
    "build": "npm run build:renderer && npm run build:electron",
    "start": "npm run build && electron .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "e2e": "npm run build && playwright test",
    "e2e:linux": "npm run build && xvfb-run -a playwright test",
    "package:win": "npm run build && node scripts/package-win.mjs"
  },
  "devDependencies": {
    "@electron/fuses": "^2.1.3",
    "@electron/packager": "^18.3.6",
    "@fontsource/exo-2": "^5.3.0",
    "@playwright/test": "^1.56.1",
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^44.9.2",
    "esbuild": "^0.24.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
